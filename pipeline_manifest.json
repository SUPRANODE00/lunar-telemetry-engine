{
  "operator_node": {
    "telemetry_interval_sec": 30,
    "security_info_logging": true,
    "proxy_optimization": true
  },
  "signal_engine": {
    "interface": "cellular_ipv6",
    "mtu_bytes": 1430,
    "local_bind_port": 3030,
    "mqtt_bridge": {
      "tls_version": "1.3",
      "keepalive_sec": 60
    }
  },
  "trinity_compilers": {
    "frontend": "threejs_render_loop",
    "backend": "express_sqlite_layer",
    "daemon": "python_telemetry_service"
  }
}
